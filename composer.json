{
    "name": "sirosoft/api",
    "description": "Production-first PHP API framework with built-in debugging, replay, and testing workflows",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "sirosoft/core": "^0.33.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.50",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "ext-redis": "Required for Redis cache, session, and rate limiter drivers",
        "ext-openssl": "Required for Encrypter (AES-256 encryption)",
        "ext-curl": "Required for HTTP Client (Http::get/post/...)",
        "ext-pdo_mysql": "Required for MySQL/MariaDB database driver",
        "ext-pdo_sqlite": "Required for SQLite database driver",
        "ext-sockets": "Required for queue worker and WebSocket support",
        "ext-fileinfo": "Required for file upload MIME type detection",
        "sirosoft/mcp-server": "MCP (Model Context Protocol) server for AI tool integration. Install via: composer require sirosoft/mcp-server"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "bin": [
        "siro"
    ],
    "scripts": {
        "test": "php vendor/bin/phpunit --no-coverage",
        "test:coverage": "php -d zend_extension=xdebug vendor/bin/phpunit --coverage-html coverage/html",
        "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse --level=max",
        "check": [
            "php -d memory_limit=512M vendor/bin/phpstan analyse --level=max --no-progress",
            "php vendor/bin/phpunit --no-coverage"
        ],
        "benchmark:ci": "@php scripts/benchmark-ci.php",
        "sbom": "@php scripts/generate-sbom.php",
        "audit:supply-chain": "@php scripts/audit-supply-chain.php",
        "health": "@php scripts/health-check.php",
        "docs:generate": "@php scripts/generate-docs.php",
        "release:check": [
            "@php scripts/release-check.php --ci"
        ],
        "release:check:strict": [
            "@php scripts/release-check.php --strict --with-prod-doctor"
        ]
    }
}
