# SiroPHP Environment Configuration
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env

APP_NAME="Siro API"
APP_ENV=local
APP_DEBUG=true

JWT_SECRET=change-this-to-a-32-char-random-string
JWT_TTL=3600
JWT_ALGORITHM=HS256

DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

CACHE_DRIVER=file
CACHE_TTL=3600

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="Siro API"

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Replay Auto-Auth (optional — auto-discovered from model/routes by default)
# AUTH_ENDPOINT=/api/auth/login
# AUTH_EMAIL_FIELD=email
# AUTH_PASSWORD_FIELD=password
# AUTH_TOKEN_PATH=data.token
# AUTH_REFRESH_ENDPOINT=/api/auth/refresh

# Admin credentials (used by replay auto-auth fallback)
# ADMIN_EMAIL=admin@siro.dev
# ADMIN_PASSWORD=admin1234
